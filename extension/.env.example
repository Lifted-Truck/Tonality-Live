# Copy to .env (gitignored). Points the CLI at Live's Extension Host module.
# This is the auto-detected path for the macOS Live 12 Beta on this machine:
EXTENSION_HOST_PATH=/Applications/Ableton Live 12 Beta.app/Contents/Helpers/ExtensionHost/ExtensionHostNodeModule.node

# Optional: override where the extension reaches the Tonality bridge service.
# Default is http://127.0.0.1:8765 (see ../bridge/server.py).
# TONALITY_BRIDGE_URL=http://127.0.0.1:8765
