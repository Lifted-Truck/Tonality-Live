#!/usr/bin/env bash
# verify — oracle dispatcher. The harness's only interface to project QC.
# Usage: ./verify fast | full | report
# Contract: exit 0 = green, nonzero = red. Writes .harness/last-verify.json.
#
# This project is a thin client (TypeScript .ablx extension) + a dependency-free
# Python bridge that consumes the Tonality (mts) engine over HTTP. The oracle
# WRAPS the commands that already gate the build; it invents no new test setup.
# Writing real unit suites (vitest for transpose, pytest for the bridge marshal)
# is tracked in ROADMAP as debt, not silently gated on here.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

TARGET="${1:-fast}"
HARNESS_DIR=".harness"
mkdir -p "$HARNESS_DIR"

# Kit-owned gates: record, leak_gate, kit_integrity (vendored + checksummed in
# .kit/, kit 2.4.0). Missing .kit/ is a HARD EXIT, not a degraded run: a
# silently skipped privacy gate is the exact bug the gate exists to prevent.
# Note this sources a RELATIVE path — the `cd "$ROOT"` above is what makes it
# resolve no matter where ./verify was invoked from.
if [ -r .kit/kit-gates.sh ]; then
  . .kit/kit-gates.sh
else
  echo "verify: .kit/kit-gates.sh missing — run kit_sync.py (gates cannot be skipped)" >&2
  exit 1
fi

BRIDGE_URL="${TONALITY_BRIDGE_URL:-http://127.0.0.1:8765}"

fast() {
  # ---- Layer-0: seconds, not minutes. CI-blocking. -------------------------
  # Kit gates accumulate into `ok` instead of early-returning: a leak and a
  # broken typecheck are independent failures, and reporting only the first
  # wastes a run. The project gates below keep their early-return — a failed
  # typecheck makes the tests after it meaningless.
  local ok=0
  kit_integrity || ok=1
  leak_gate     || ok=1

  # 1) TypeScript typecheck — the check that already fronts every build.
  echo "verify[fast]: tsc --noEmit (extension/)"
  if [ ! -d extension/node_modules ]; then
    echo "  SKIP: extension/node_modules absent — run 'cd extension && npm install' first" >&2
    echo "  (typecheck is the load-bearing gate; not skipping silently on CI)" >&2
    return 1
  fi
  ( cd extension && npx --no-install tsc --noEmit ) || return 1

  # 2) transpose unit tests — pure arithmetic, node:test via tsx, zero new deps.
  echo "verify[fast]: node:test (extension/)"
  local specs
  specs=$(cd extension && find src -name '*.test.ts' 2>/dev/null)
  if [ -n "$specs" ]; then
    # shellcheck disable=SC2086  # word-splitting $specs into multiple file args is intended
    ( cd extension && node --import tsx --test $specs ) || return 1
  else
    echo "  (no *.test.ts found)"
  fi

  # 3) Python sources compile (syntax/import-time errors are a real red).
  echo "verify[fast]: py_compile bridge/*.py"
  python3 -m py_compile bridge/server.py bridge/test_bridge.py || return 1
  [ "$ok" -eq 0 ] && echo "verify[fast]: OK"
  return "$ok"
}

full() {
  fast || return $?
  # ---- Layer-E: the whole gate. Run before closing a queue item. -----------
  # 3) Production bundle actually builds (esbuild via build.ts).
  echo "verify[full]: npm run build (extension/)"
  ( cd extension && npm run build ) || return 1

  # 4) Bridge glue unit tests (marshalling + summary shaping). These need the
  #    Tonality engine importable, so they SKIP (not fail) when it's absent —
  #    prefer the Tonality venv's python, which has mts + mido.
  echo "verify[full]: bridge unit tests"
  local repo pyv
  repo="${TONALITY_REPO:-$HOME/Documents/Tonality}"
  pyv="$repo/.venv/bin/python3"
  [ -x "$pyv" ] || pyv="python3"
  TONALITY_REPO="$repo" "$pyv" -m unittest bridge.test_bridge || return 1

  # 5) Live bridge contract — degrade VISIBLY when the Tonality engine is
  #    absent (rule 2). A machine without the venv is not a red; a reachable
  #    bridge returning a wrong shape IS.
  echo "verify[full]: bridge contract @ $BRIDGE_URL"
  local health
  health=$(curl -sf --max-time 3 "$BRIDGE_URL/health" 2>/dev/null) || {
    echo "  SKIP: bridge not reachable at $BRIDGE_URL — start it with the Tonality venv" >&2
    echo "  (degraded per INTEGRATIONS rule 2; not a red)" >&2
    echo "verify[full]: OK (bridge check skipped)"
    return 0
  }
  echo "  /health -> $health"
  local analysis
  analysis=$(curl -sf --max-time 5 -X POST "$BRIDGE_URL/analyze" \
    -H 'Content-Type: application/json' \
    -d '{"bpm":120,"notes":[{"pitch":60,"startTime":0,"duration":1},{"pitch":64,"startTime":0,"duration":1},{"pitch":67,"startTime":0,"duration":1}]}' 2>/dev/null) || {
    echo "  FAIL: /analyze did not respond 2xx while bridge was up" >&2
    return 1
  }
  # Contract: response carries a 'summary' object (see extension/src/bridge.ts).
  printf '%s' "$analysis" | python3 -c 'import json,sys; d=json.load(sys.stdin); assert isinstance(d.get("summary"),dict), "no summary in /analyze response"; print("  /analyze -> summary present:", list(d["summary"].keys()))' || {
    echo "  FAIL: /analyze response missing expected 'summary' contract" >&2
    return 1
  }

  # /transform (Phase-7 conform). Same chromatic fixture the ratification pinned:
  # C C# D F# into C major -> C# collides onto C, which must be REPORTED (R2).
  local conformed
  conformed=$(curl -sf --max-time 5 -X POST "$BRIDGE_URL/transform" \
    -H 'Content-Type: application/json' \
    -d '{"op":"fit_to_key","tonicPc":0,"mode":"major","bpm":120,"notes":[{"pitch":60,"startTime":0,"duration":1},{"pitch":61,"startTime":0,"duration":1},{"pitch":62,"startTime":0,"duration":1},{"pitch":66,"startTime":0,"duration":1}]}' 2>/dev/null) || {
    echo "  FAIL: /transform did not respond 2xx while bridge was up" >&2
    return 1
  }
  printf '%s' "$conformed" | python3 -c '
import json, sys
d = json.load(sys.stdin)
notes, report = d.get("notes"), d.get("report")
assert isinstance(notes, list) and len(notes) == 4, "note count not preserved"
for n in notes:
    assert set(n) == {"pitch", "startTime", "duration", "velocity"}, f"not a NoteDescription: {n}"
assert isinstance(report, dict), "no report object"
assert "events" not in report, "report should not duplicate notes as events"
for key in ("collisions", "notes_snapped", "ties_resolved", "tie_break"):
    assert key in report, f"report missing {key}"
print("  /transform -> %d notes, %d snapped, %d collision(s), tie_break=%s"
      % (len(notes), report["notes_snapped"], len(report["collisions"]), report["tie_break"]))
' || {
    echo "  FAIL: /transform response violated the notes+report contract" >&2
    return 1
  }
  # /transform op=remap_by_degree. The walk G F E D C translated into natural
  # minor must keep 5 DISTINCT pitches — remap preserves degrees where conform
  # would merge. Checked live because it is the difference a user hears.
  local remapped
  remapped=$(curl -sf --max-time 5 -X POST "$BRIDGE_URL/transform" \
    -H 'Content-Type: application/json' \
    -d '{"op":"remap_by_degree","sourceScale":"Ionian","sourceRoot":0,"targetScale":"Natural Minor","targetRoot":0,"notes":[{"pitch":67,"startTime":0,"duration":1},{"pitch":65,"startTime":1,"duration":1},{"pitch":64,"startTime":2,"duration":1},{"pitch":62,"startTime":3,"duration":1},{"pitch":60,"startTime":4,"duration":1}]}' 2>/dev/null) || {
    echo "  FAIL: /transform op=remap_by_degree did not respond 2xx" >&2
    return 1
  }
  printf '%s' "$remapped" | python3 -c '
import json, sys
d = json.load(sys.stdin)
notes = d["notes"]
pitches = [n["pitch"] for n in notes]
assert len(notes) == 5, f"note count not preserved: {len(notes)}"
assert len(set(pitches)) == 5, f"remap merged notes (walk destroyed): {pitches}"
assert "edits" in d["report"], "report missing edits (needed for before/after pairing)"
print("  /transform remap -> %s, %d distinct (walk intact)" % (pitches, len(set(pitches))))
' || {
    echo "  FAIL: /transform remap violated the walk-preservation contract" >&2
    return 1
  }

  # The refusal is a feature: 7 degrees cannot translate into 5. Expect a 4xx
  # carrying the engine's own reason, never a silent success.
  local code
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 -X POST "$BRIDGE_URL/transform" \
    -H 'Content-Type: application/json' \
    -d '{"op":"remap_by_degree","sourceScale":"Ionian","sourceRoot":0,"targetScale":"Minor Pentatonic","targetRoot":0,"notes":[{"pitch":60,"startTime":0,"duration":1}]}' 2>/dev/null)
  if [ "$code" = "400" ]; then
    echo "  /transform remap 7->5 -> $code (refused, as designed)"
  else
    echo "  FAIL: unequal-cardinality remap returned $code, expected 400" >&2
    return 1
  fi

  echo "verify[full]: OK"
  return 0
}

case "$TARGET" in
  fast)   fast;  record fast  $? ;;
  full)   full;  record full  $? ;;
  report) cat "$HARNESS_DIR/last-verify.json" 2>/dev/null || { echo '{"target":null,"exit":null}'; exit 1; } ;;
  *)      echo "usage: ./verify fast|full|report" >&2; exit 64 ;;
esac
